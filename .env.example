# --- Trails (https://dashboard.trails.build) ---
VITE_TRAILS_API_KEY=

# --- Supabase (leave blank to run on the built-in localStorage store) ---
# Browser-safe anon key only — never put a service role key in a Vite app,
# since everything prefixed VITE_ ships to the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- App ---
VITE_APP_URL=http://localhost:5173
VITE_DEFAULT_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000dEaD
